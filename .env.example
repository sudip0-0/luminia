# Copy to `.env` for local runs. Never commit real secrets.

# API
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
DATABASE_URL=postgres://lumina:lumina@localhost:5432/lumina
REDIS_URL=redis://localhost:6379
AUTH_ACCESS_TOKEN_SECRET=local-dev-access-token-secret-min-32-chars
# AUTH_ALLOW_TEST_SECRET=1

# Typesense
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=xyz

# Optional OpenTelemetry OTLP HTTP endpoint (no-op when unset)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Mobile (Expo)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000
